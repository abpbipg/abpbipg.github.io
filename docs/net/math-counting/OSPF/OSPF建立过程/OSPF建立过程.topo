        <txttip left="864" top="285" right="1014" bottom="343" content="邻居建立&#x0D;&#x0A;通过组播方式发送&#x0D;&#x0A;224.0.0.5" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="876" top="115" right="1243" bottom="248" content="邻居建立好后&#x0D;&#x0A;AR1 和 AR2 会通过收到的Hello报文，选举DR&#x0D;&#x0A;  1. 优先级  （越大越优）&#x0D;&#x0A;  2. RID 大小（越大越优）&#x0D;&#x0A;【优先级为0的不参与选举】&#x0D;&#x0A;&#x0D;&#x0A;等 DR选举出来后，进入 Exstart 状态" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="143" top="367" right="211" bottom="387" content="Exstart" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="801" top="367" right="869" bottom="387" content="Exstart" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="352" top="358" right="692" bottom="397" content="DD &#x0D;&#x0A;RID=1.1.1.1 M/S = 1 I = 1 M=1 Seq = X" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="233" top="419" right="609" bottom="533" content="DD&#x0D;&#x0A; RID = 2.2.2.2 &#x0D;&#x0A; M/S = 1 &#x0D;&#x0A; M = 1 （代表后面还有报文）&#x0D;&#x0A; I = 1 （代表连续发送DD报文的第一个报文）&#x0D;&#x0A; Seq = Y" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="280" top="538" right="548" bottom="614" content="DD&#x0D;&#x0A;RID = 1.1.1.1 M/S = 0 Seq = Y&#x0D;&#x0A;LSA Header：&#x0D;&#x0A; Router-LSA（1.1.1.1）" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="137" top="550" right="214" bottom="570" content="Exchange" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
