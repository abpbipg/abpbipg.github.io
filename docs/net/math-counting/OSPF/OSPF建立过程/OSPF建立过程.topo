        <txttip left="322" top="624" right="590" bottom="757" content="DD&#x0D;&#x0A; RID = 2.2.2.2&#x0D;&#x0A; M/S = 1&#x0D;&#x0A; M = 0 （代表最后一个DD报文）&#x0D;&#x0A; Seq = Y + 1&#x0D;&#x0A; LSA Header：&#x0D;&#x0A;  Router-LSA（2.2.2.2）" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
