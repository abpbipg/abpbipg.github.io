        <txttip left="306" top="510" right="380" bottom="532" content="vlan 20" fontname="Consolas" fontstyle="0" editsize="130" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="652" top="506" right="726" bottom="528" content="vlan 20" fontname="Consolas" fontstyle="0" editsize="130" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="711" top="149" right="1364" bottom="354" content="1、为交换机配置端口类型&#x0D;&#x0A;   其中交换机连接PC的端口设置为access口，并且根据题目标注划分vlan&#x0D;&#x0A;   交换机相连的端口设置为trunk口，放行vlan 10与vlan 20&#x0D;&#x0A;2、在交换机上配置单域MSTP，要求如下：&#x0D;&#x0A;   域名：huawei&#x0D;&#x0A;   域等级：15&#x0D;&#x0A;   实例10，划分vlan 10&#x0D;&#x0A;   实例20，划分vlan 20&#x0D;&#x0A;   S1作为实例10的主根桥，作为实例20的备份根桥；&#x0D;&#x0A;   S2作为实例20的主根桥，作为实例10的备份根桥；" fontname="Consolas" fontstyle="0" editsize="130" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
</topo>
